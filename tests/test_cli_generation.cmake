if(NOT DEFINED SMC_EXECUTABLE OR NOT DEFINED SMC_SOURCE_DIR OR
   NOT DEFINED TEST_OUTPUT_DIR)
    message(FATAL_ERROR "SMC_EXECUTABLE, SMC_SOURCE_DIR, and TEST_OUTPUT_DIR are required")
endif()

set(default_dir "${TEST_OUTPUT_DIR}/default")
file(MAKE_DIRECTORY "${default_dir}")
configure_file("${SMC_SOURCE_DIR}/tests/cpp_fixture.sm" "${default_dir}/machine.sm" COPYONLY)
execute_process(
    COMMAND "${SMC_EXECUTABLE}" -c++ "${default_dir}/machine.sm"
    RESULT_VARIABLE default_result
    OUTPUT_VARIABLE default_stdout
    ERROR_VARIABLE default_stderr)
if(NOT default_result EQUAL 0)
    message(FATAL_ERROR "Default-output generation failed: ${default_stdout}${default_stderr}")
endif()
if(NOT EXISTS "${default_dir}/machine.hpp" OR NOT EXISTS "${default_dir}/machine.cpp")
    message(FATAL_ERROR "Default-output generation did not create machine.hpp and machine.cpp")
endif()
file(READ "${default_dir}/machine.hpp" default_header)
file(READ "${default_dir}/machine.cpp" default_source)
string(FIND "${default_header}" "class Machine" machine_declaration)
string(FIND "${default_source}" "#include \"machine.hpp\"" generated_include)
if(machine_declaration EQUAL -1 OR generated_include EQUAL -1)
    message(FATAL_ERROR "Generated default output is missing expected C++ declarations")
endif()

set(selected_dir "${TEST_OUTPUT_DIR}/selected")
set(check_dir "${TEST_OUTPUT_DIR}/check")
file(MAKE_DIRECTORY "${selected_dir}" "${check_dir}")
execute_process(
    COMMAND "${SMC_EXECUTABLE}" -c++ -d "${selected_dir}"
            "${SMC_SOURCE_DIR}/tests/cpp_fixture.sm"
    RESULT_VARIABLE selected_result
    OUTPUT_VARIABLE selected_stdout
    ERROR_VARIABLE selected_stderr)
if(NOT selected_result EQUAL 0)
    message(FATAL_ERROR "Selected-directory generation failed: ${selected_stdout}${selected_stderr}")
endif()
if(NOT EXISTS "${selected_dir}/cpp_fixture.hpp" OR
   NOT EXISTS "${selected_dir}/cpp_fixture.cpp")
    message(FATAL_ERROR "-d did not direct generated files to the selected directory")
endif()

file(WRITE "${selected_dir}/cpp_fixture.hpp" "stale")
execute_process(
    COMMAND "${SMC_EXECUTABLE}" -c++ -d "${selected_dir}"
            "${SMC_SOURCE_DIR}/tests/cpp_fixture.sm"
    RESULT_VARIABLE overwrite_result
    OUTPUT_VARIABLE overwrite_stdout
    ERROR_VARIABLE overwrite_stderr)
if(NOT overwrite_result EQUAL 0)
    message(FATAL_ERROR "Overwriting generated files failed: ${overwrite_stdout}${overwrite_stderr}")
endif()
file(READ "${selected_dir}/cpp_fixture.hpp" selected_header)
string(FIND "${selected_header}" "Generated by smc_cpp" generated_marker)
if(generated_marker EQUAL -1)
    message(FATAL_ERROR "Existing generated header was not overwritten")
endif()

execute_process(
    COMMAND "${SMC_EXECUTABLE}" -c++ --check -d "${check_dir}"
            "${SMC_SOURCE_DIR}/tests/cpp_fixture.sm"
    RESULT_VARIABLE check_result
    OUTPUT_VARIABLE check_stdout
    ERROR_VARIABLE check_stderr)
if(NOT check_result EQUAL 0)
    message(FATAL_ERROR "Check-only validation failed: ${check_stdout}${check_stderr}")
endif()
if(EXISTS "${check_dir}/cpp_fixture.hpp" OR EXISTS "${check_dir}/cpp_fixture.cpp")
    message(FATAL_ERROR "--check created generated files")
endif()

set(invalid_dir "${TEST_OUTPUT_DIR}/invalid")
file(MAKE_DIRECTORY "${invalid_dir}")
execute_process(
    COMMAND "${SMC_EXECUTABLE}" -c++ -d "${invalid_dir}"
            "${SMC_SOURCE_DIR}/tests/invalid.sm"
    RESULT_VARIABLE invalid_result
    OUTPUT_VARIABLE invalid_stdout
    ERROR_VARIABLE invalid_stderr)
if(invalid_result EQUAL 0)
    message(FATAL_ERROR "Invalid FSM unexpectedly generated C++ files")
endif()
if(EXISTS "${invalid_dir}/invalid.hpp" OR EXISTS "${invalid_dir}/invalid.cpp")
    message(FATAL_ERROR "Invalid FSM left generated output files")
endif()
